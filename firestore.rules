rules_version = '2';

// ঢাকার বাস ভাড়া — Firestore-এর নিয়ম।
//
// Firebase Console → Firestore Database → Rules-এ পুরোটা পেস্ট করে
// Publish দিন।
//
// মূল কথা: পড়তে সবাই পারবে (সাইটটা সবার জন্য), কিন্তু লিখতে হলে
// লগইন করা থাকতে হবে (anonymous auth-ও চলবে) আর নিজের ডকুমেন্টেই
// কেবল লেখা যাবে। ডকুমেন্টের আইডি = ব্যবহারকারীর uid, তাই এক ফোন
// থেকে একটা বাসে একটাই মত জমা হয় — বারবার ভোট দিয়ে সংখ্যা বাড়ানো
// যায় না।

service cloud.firestore {
  match /databases/{database}/documents {

    // ── সব বাসের গোনাগুনতি, এক ডকুমেন্টে ──
    // পুরো তালিকা এক ডকুমেন্টে রাখায় পেজ খুললে মাত্র একটা read লাগে।
    match /summary/all {
      allow read: if true;
      // লগইন করা যে কেউ নিজের ভোটের সময় গোনাগুনতি হালনাগাদ করে।
      // ১ MiB-এর সীমার অনেক নিচে থাকে (২০০ বাসে ~১০ KB)।
      allow write: if request.auth != null;
    }

    // ── একজনের একটা বাস নিয়ে মত ──
    match /buses/{bus}/reviews/{uid} {
      allow read: if true;

      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && validReview(request.resource.data);

      // নিজের মত নিজেই মুছতে পারবে
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // ── "সবার রিপোর্ট" পাতা ──
    // সব বাসের রিভিউ একসাথে সময় ধরে সাজিয়ে আনা হয় (collectionGroup)।
    // উপরের /buses/{bus}/reviews/{uid} নিয়মটা এই কোয়েরিতে খাটে না —
    // collectionGroup-এর জন্য পথটা {path=**} দিয়ে লিখতে হয়। এটা না
    // থাকলে কোয়েরি "false for 'list'" বলে আটকে যায়।
    match /{path=**}/reviews/{uid} {
      allow read: if true;
    }

    // ── নতুন বাসের প্রস্তাব ──
    // যে কেউ প্রস্তাব দিতে পারে, কিন্তু সরাসরি সাইটে ঢোকে না —
    // status "pending" হয়ে বসে থাকে যতক্ষণ না অ্যাডমিন ছাড়েন।
    match /proposals/{id} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.by == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.yes == 0
        && request.resource.data.no == 0
        && validProposal(request.resource.data);

      // সাধারণ ব্যবহারকারী শুধু গোনাগুনতি বদলাতে পারে। সাথে status
      // "pending" থেকে "approved" হতে পারে, কিন্তু তখনই — যখন যথেষ্ট
      // মানুষ চিনি বলেছেন (yes − no >= ১০)। বাসের নাম বা স্টপেজ
      // এডিট করা যায় না, আর "rejected" করা শুধু অ্যাডমিনের কাজ।
      allow update: if isAdmin() || (request.auth != null && (
           request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['yes', 'no'])
        || (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['yes', 'no', 'status'])
            && resource.data.status == 'pending'
            && request.resource.data.status == 'approved'
            && request.resource.data.yes - request.resource.data.no >= 10)
      )
      && request.resource.data.yes is int && request.resource.data.yes >= 0
      && request.resource.data.no is int && request.resource.data.no >= 0);

      allow delete: if isAdmin();
    }

    // প্রস্তাবে কে কী ভোট দিয়েছে — ডকুমেন্টের আইডি uid, তাই এক ফোন এক ভোট
    match /proposals/{id}/votes/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.v in ['yes', 'no'];
    }

    // উপরে যা লেখা নেই, সব বন্ধ
    match /{document=**} {
      allow read, write: if false;
    }
  }

  // অ্যাডমিন কে — Google লগইনের ইমেইল দিয়ে চেনা হয়। সাধারণ
  // ব্যবহারকারীরা anonymous, তাঁদের কোনো ইমেইল থাকে না, তাই এই শর্ত
  // তাঁদের ক্ষেত্রে কখনোই সত্য হয় না।
  function isAdmin() {
    return request.auth != null
      && request.auth.token.email_verified == true
      && request.auth.token.email == 'itsrokonujjaman@gmail.com';
  }

  function validProposal(d) {
    return d.keys().hasOnly(['bn', 'en', 'stops', 'note', 'by', 'at', 'status', 'yes', 'no'])
      && d.bn is string && d.bn.size() >= 2 && d.bn.size() <= 40
      && d.en is string && d.en.size() <= 40
      && d.note is string && d.note.size() <= 200
      && d.stops is list && d.stops.size() >= 3 && d.stops.size() <= 60;
  }

  function validReview(d) {
    return d.keys().hasOnly(['v', 'rating', 'text', 'name', 'bus', 'at'])
      && (d.v == null || d.v in ['runs', 'no', 'unsure'])
      && d.rating is int && d.rating >= 0 && d.rating <= 5
      && d.text is string && d.text.size() <= 500
      && d.name is string && d.name.size() <= 40
      && d.bus is string && d.bus.size() <= 80;
  }
}
